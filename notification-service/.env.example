# Notification database settings used by Docker Compose and Make.
NOTIFICATION_DB_NAME=notifications
NOTIFICATION_DB_USER=notifications
NOTIFICATION_DB_PASSWORD=notifications_dev_password
NOTIFICATION_DB_PORT=5435
NOTIFICATION_DATABASE_URL=postgres://notifications:notifications_dev_password@localhost:5435/notifications?sslmode=disable

# Notification-service runtime settings. Compose overrides DATABASE_URL and
# RABBITMQ_URL with the container hostnames; these localhost values support running
# Go on the host.
ENVIRONMENT=development
DATABASE_URL=postgres://notifications:notifications_dev_password@localhost:5435/notifications?sslmode=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

RABBITMQ_URL=amqp://orders:orders_dev_password@localhost:5672/
# How many deliveries the broker may hold open with this consumer. Explicit rather
# than the default of unlimited, which would hand over the whole queue at once.
RABBITMQ_PREFETCH_COUNT=10
RABBITMQ_RECONNECT_DELAY=5s
# Bounds one publication to the parked queue, including its confirmation.
RABBITMQ_PUBLISH_TIMEOUT=5s

# How long one delivery may take. It must stay below SEND_LEASE — the configuration
# refuses to load otherwise — because a handler that outlives its claim on an effect
# would let another worker reclaim it and send a second email while the first is
# still in flight.
HANDLE_TIMEOUT=15s
# How long a claim on one notification effect is held. A worker that dies mid-send
# leaves its claim behind, and this is how long before another worker may take it.
SEND_LEASE=60s
# How long draining in-flight deliveries may take at shutdown.
SHUTDOWN_TIMEOUT=20s

LOG_LEVEL=debug
LOG_CALLER=true
