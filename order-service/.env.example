# Order database settings used by Docker Compose and Make.
ORDER_DB_NAME=orders
ORDER_DB_USER=orders
ORDER_DB_PASSWORD=orders_dev_password
ORDER_DB_PORT=5433
ORDER_DATABASE_URL=postgres://orders:orders_dev_password@localhost:5433/orders?sslmode=disable

# Order-service runtime settings. Compose overrides DATABASE_URL with the
# order-postgres hostname; this localhost value supports running Go on the host.
ENVIRONMENT=development
DATABASE_URL=postgres://orders:orders_dev_password@localhost:5433/orders?sslmode=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
HTTP_SERVER_ADDRESS=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
LOG_LEVEL=debug
LOG_CALLER=true
INVENTORY_GRPC_ADDRESS=inventory:50051
# Bounds a single reservation attempt, not the three-attempt sequence.
INVENTORY_GRPC_TIMEOUT=3s
