# Inventory database settings used by Docker Compose and Make.
INVENTORY_DB_NAME=inventory
INVENTORY_DB_USER=inventory
INVENTORY_DB_PASSWORD=inventory_dev_password
INVENTORY_DB_PORT=5434
INVENTORY_DATABASE_URL=postgres://inventory:inventory_dev_password@localhost:5434/inventory?sslmode=disable

# Inventory-service runtime settings. Compose overrides DATABASE_URL with the
# inventory-postgres hostname; this localhost value supports running Go on the host.
ENVIRONMENT=development
DATABASE_URL=postgres://inventory:inventory_dev_password@localhost:5434/inventory?sslmode=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
GRPC_SERVER_ADDRESS=:50051
GRPC_SHUTDOWN_TIMEOUT=10s
GRPC_MAX_CONNECTION_IDLE=5m
GRPC_MAX_CONNECTION_AGE=30m
GRPC_MAX_CONNECTION_AGE_SLOP=10s
LOG_LEVEL=debug
LOG_CALLER=true
